# ─── General ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# URL del frontend (CORS y redirecciones de correo/Google)
FRONTEND_URL=http://localhost:5173

# ─── Base de datos ─────────────────────────────────────────
# Local: PostgreSQL de docker-compose.yml (docker compose up -d)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nomina"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/nomina"
# Supabase (Project Settings → Database → Connection string):
#   DATABASE_URL = Transaction pooler (puerto 6543) + ?pgbouncer=true  → la usa la aplicación
#   DIRECT_URL   = Session pooler o Direct (puerto 5432)                → la usa Prisma Migrate

# ─── JWT ───────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DIAS=7

# ─── Google OAuth (Google Cloud Console → Credenciales) ────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ─── Resend ────────────────────────────────────────────────
# Sin API key los correos se muestran en consola (modo desarrollo)
RESEND_API_KEY=
MAIL_FROM="Nómina Riwi <onboarding@resend.dev>"

# ─── Ejecución programada (pg_cron → API) ──────────────────
CRON_SECRET=cambia-esto-por-otro-secreto-de-al-menos-32-caracteres

# ─── Seed (solo para `npx prisma db seed`) ─────────────────
SEED_ADMIN_EMAIL=admin@financierariwi.com
SEED_ADMIN_PASSWORD=CambiaEsta2026
